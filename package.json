{
  "name": "game-deal-explorer-mcp",
  "version": "0.1.0",
  "description": "IsThereAnyDeal과 RAWG로 할인 게임을 찾는 Node.js stdio MCP 서버",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nodejs",
    "typescript",
    "game-deals",
    "steam",
    "rawg",
    "isthereanydeal"
  ],
  "bin": {
    "game-deal-explorer-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.0.18"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
